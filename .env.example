# Padrão: mock, openrouter, nvidia, openai ou azure. O seletor permite mudar por envio.
AI_PROVIDER=mock
# Valores usados somente no servidor. Nenhum segredo deve usar NEXT_PUBLIC_.
# OpenRouter: somente openrouter/free ou um ID de modelo terminado em :free.
# Crie sua chave em https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# NVIDIA Build: acesso gratuito para desenvolvimento/avaliação, sujeito a limites.
# Crie sua chave em https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
